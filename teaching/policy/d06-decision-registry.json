    "TCH-0691": {
      "decision_id": "D06-SOURCE-MEANINGFULNESS-001",
      "status": "DECIDED",
      "owner": "Curriculum/Coverage",
      "policy_version": "source-meaningfulness.v1",
      "decision": {
        "classes": {
          "ACADEMICALLY_MEANINGFUL": "Conveys a required concept, skill, definition, process, reasoning pattern, evidence/source use, example class or other learning content inside approved scope.",
          "DUPLICATE": "Substantively repeats another inventoried item and must point to the retained canonical item.",
          "ADMINISTRATIVE": "Logistics, navigation, metadata or policy text that is not itself academic content.",
          "FORMATTING_ONLY": "Layout or presentation artifact with no independent academic meaning.",
          "OBSOLETE": "Superseded or no longer valid content with explicit reason and replacement/version provenance where available.",
          "OUTSIDE_APPROVED_COURSE_SCOPE": "Academically meaningful content that is outside the approved Course scope and therefore remains inventoried with explicit scope authority/reason."
        },
        "silent_drop_allowed": false,
        "exclusion_requires_reason_and_provenance": true,
        "ai_classification_directly_authoritative": false
      },
      "rationale": "Every source item is inventoried and either mapped or explicitly classified; meaningful content cannot disappear because a model summarized it away.",
      "downstream_deliveries": ["D07","D08"],
      "invariants": ["INV-COVERAGE-01"],
      "sources": ["Blueprint §§53-60, 131-134", "D05→D06 handoff TCH-0691"]
    },
    "TCH-0692": {
      "decision_id": "D06-VALIDATED-PRIOR-KNOWLEDGE-001",
      "status": "CONFIGURED",
      "owner": "Evidence/SKM with deterministic validation policy",
      "policy_version": "validated-prior-knowledge.v1",
      "decision": {
        "student_intake_self_report_is_evidence": false,
        "minimum_independent_verification_opportunities": 2,
        "distinct_probe_or_criterion_evidence_required": true,
        "varied_or_uncued_probe_required_when_construct_supports_it": true,
        "critical_criteria_must_all_pass": true,
        "unresolved_material_contradiction_allowed": false,
        "external_evidence_allowed_only_with_explicit_verifier_and_provenance": true,
        "course_context_override_allowed": true,
        "override_must_be_versioned_and_criterion_based": true
      },
      "rationale": "Prior knowledge is validated by repeated independent criterion-aligned evidence, not confidence, intake text or one lucky item.",
      "downstream_deliveries": ["D07","D08","D17"],
      "invariants": ["INV-INTAKE-01","INV-ELIG-01","INV-TRUTH-01"],
      "sources": ["Blueprint §§112-129, 132, 356-358", "Capability Registry validated_prior_knowledge_interpretation", "D05→D06 handoff TCH-0692"]
    },
    "TCH-0693": {
      "decision_id": "D06-INCOMPLETE-REQUIRED-CONTENT-001",
      "status": "DECIDED",
      "owner": "Course lifecycle/Progression",
      "policy_version": "incomplete-required-content.v1",
      "decision": {
        "planned_end_date_implies_completion": false,
        "unresolved_required_content_behavior": ["TEACHING_ENDED","FINALIZING","INCOMPLETE"],
        "unresolved_required_content_may_be_completed_without_teaching_or_vpk": false,
        "incomplete_is_fail": false,
        "incomplete_may_reenter_finalizing_when_resolved": true,
        "administrative_archive_preserves_incomplete_history": true
      },
      "rationale": "A date ending does not certify academic completion. Required content must be Taught or Validated Prior Knowledge before completion can be validly certified.",
      "downstream_deliveries": ["D08","D10","D21"],
      "invariants": ["INV-COVERAGE-01","INV-TRUTH-01"],
      "sources": ["Blueprint §§49, 485", "D05→D06 handoff TCH-0693"]
    },
    "TCH-0694": {
      "decision_id": "D06-ASSESSMENT-ELIGIBILITY-EXCEPTIONS-001",
      "status": "DECIDED",
      "owner": "Assessment Eligibility Ledger",
      "policy_version": "assessment-eligibility-exceptions.v1",
      "decision": {
        "first_release_graded_exceptions": [],
        "graded_content_must_be": ["TAUGHT","VALIDATED_PRIOR_KNOWLEDGE"],
        "explicit_prerequisite_must_be_validated_before_graded_use": true,
        "ungraded_diagnostic_may_probe_untaught_or_unvalidated_prerequisite": true,
        "raw_subject_scope_never_implies_eligibility": true,
        "future_exception_requires_versioned_change_control": true
      },
      "rationale": "The first release closes the loophole entirely: graded scope is taught or validated. A prerequisite label alone is not permission to grade unverified content; Diagnostics remain the explicit non-graded exception.",
      "downstream_deliveries": ["D07","D17"],
      "invariants": ["INV-ELIG-01","INV-PPL-02"],
      "sources": ["Blueprint §§204, 259-260", "D05→D06 handoff TCH-0694"]
    }
  }
