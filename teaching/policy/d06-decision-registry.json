    "TCH-0074": {
      "decision_id": "D06-SKM-ALGORITHM-001",
      "status": "CONFIGURED",
      "owner": "Student Knowledge Model",
      "policy_version": "skm-evidence-state-machine.v1",
      "decision": {
        "algorithm": "EVIDENCE_QUALITY_STATE_MACHINE_V1",
        "durable_states": ["UNSEEN","INTRODUCED","ASSISTED","EMERGING","INDEPENDENT","SECURE","TRANSFERABLE"],
        "overlays": ["FRAGILE","BLOCKED","REGRESSED"],
        "rules": {
          "INTRODUCED": "authoritative instruction exposure exists",
          "ASSISTED": "successful performance exists only with material support",
          "EMERGING": "at least one independent success exists but evidence is inconsistent or thin",
          "INDEPENDENT": "at least two successful independent opportunities exist with no unresolved material contradiction",
          "SECURE": "INDEPENDENT plus successful delayed independent retrieval",
          "TRANSFERABLE": "independent success on a legitimate varied/integrated application required by the construct",
          "FRAGILE": "new contrary evidence raises uncertainty after prior competence",
          "REGRESSED": "repeated substantive independent contrary evidence shows loss of previously demonstrated capability",
          "BLOCKED": "authoritative planning determines normal progression unsafe after materially different remediation attempts or prerequisite failure"
        },
        "time_alone_may_reduce_certainty_but_not_decree_knowledge_loss": true,
        "gradebook_marks_are_not_direct_state_assignments": true,
        "student_facing_raw_probability_or_weight": false
      },
      "rationale": "The initial SKM uses transparent evidence-quality transitions rather than fabricated probabilistic precision. It remains multidimensional, evidential and separate from official marks.",
      "downstream_deliveries": ["D12","D13"],
      "invariants": ["INV-TRUTH-01"],
      "sources": ["Blueprint §§112-129, 516", "D05→D06 handoff TCH-0074"]
    },
    "TCH-0075": {
      "decision_id": "D06-SCHEDULER-HEADROOM-001",
      "status": "CONFIGURED",
      "owner": "Scheduler/Calendar",
      "policy_version": "recovery-headroom.v1",
      "decision": {
        "target_headroom_ratio": 0.20,
        "minimum_headroom_ratio": 0.15,
        "core_work_capacity_ceiling_at_target": 0.80,
        "hard_constraints_can_be_violated": false,
        "required_content_can_be_deleted_to_fit": false,
