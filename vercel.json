{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/kiwi_product_v3.css", "dest": "/public/kiwi_product_v3.css" },
    { "src": "/kiwi_product_v3.js", "dest": "/public/kiwi_product_v3.js" },
    { "src": "/kiwi_bubbles_v1.css", "dest": "/public/kiwi_bubbles_v1.css" },
    { "src": "/kiwi_bubbles_v1.js", "dest": "/public/kiwi_bubbles_v1.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
